@startuml er_datalogical

title Datalogical ER Model (PostgreSQL)

hide circle
hide empty members

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 4
skinparam nodesep 55
skinparam ranksep 65

skinparam entity {
  BackgroundColor #F7FBF5
  BorderColor #5B8C51
  FontName Monospaced
}

skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}

!define PK(x) <b><color:#B8860B><&key></color> x</b>
!define FK(x) <color:#4B55B5><&link-intact></color> x
!define PFK(x) <b><color:#B8860B><&key></color><color:#4B55B5><&link-intact></color> x</b>
!define TABLE(name, desc) entity "<b>name</b>\n<size:10><i>desc</i></size>" as name

' ---------------- Users & access ----------------
TABLE(roles, "User roles that define access rights") {
  * PK(id) : SERIAL
  --
  * name : VARCHAR(64) <<UQ>>
  description : TEXT
}

TABLE(app_users, "Application users (employees)") {
  * PK(id) : BIGSERIAL
  --
  * login : VARCHAR(64) <<UQ>>
  * password : VARCHAR(255)  -- hash
  * salt : VARCHAR(64)
  * name : VARCHAR(255)
  * FK(role_id) : INTEGER
  description : TEXT
}

TABLE(user_tokens, "API access tokens issued to users") {
  * PK(id) : BIGSERIAL
  --
  * FK(user_id) : BIGINT
  * token_uuid : UUID <<UQ>>
  name : VARCHAR(128)
  * creation_date : TIMESTAMPTZ <<DF now()>>
  * expiration_date : TIMESTAMPTZ
  <<CK expiration_date > creation_date>>
}

' ---------------- Customers & orders ----------------
TABLE(customers, "Customers who place orders") {
  * PK(id) : BIGSERIAL
  --
  * name : VARCHAR(255)
  description : TEXT
}

TABLE(contact_types, "Dictionary of contact kinds with a value validation regex") {
  * PK(id) : SERIAL
  --
  * name : VARCHAR(64) <<UQ>>
  regex : TEXT
  description : TEXT
}

TABLE(customer_contacts, "Contact details of a customer") {
  * PK(id) : BIGSERIAL
  --
  * FK(customer_id) : BIGINT
  * FK(contact_type_id) : INTEGER
  name : VARCHAR(255)
  * value : VARCHAR(512)
}

TABLE(orders, "Customer production orders") {
  * PK(id) : BIGSERIAL
  --
  * FK(customer_id) : BIGINT
  * FK(creator_id) : BIGINT
  delivery_date : DATE
  description : TEXT
  * creation_timestamp : TIMESTAMPTZ <<DF now()>>
}

TABLE(order_items, "Order lines: product and quantity") {
  * PK(id) : BIGSERIAL
  --
  * FK(order_id) : BIGINT
  * FK(nomenclature_id) : BIGINT
  * quantity : NUMERIC(14,3) <<CK > 0>>
  description : TEXT
}

TABLE(nomenclatures, "Products that can be manufactured") {
  * PK(id) : BIGSERIAL
  --
  * name : VARCHAR(255) <<UQ>>
  description : TEXT
}

' ---------------- Technological maps ----------------
TABLE(techmaps, "Technological maps: production plans covering one or more order items") {
  * PK(id) : BIGSERIAL
  --
  * FK(creator_id) : BIGINT
  * creation_timestamp : TIMESTAMPTZ <<DF now()>>
}

TABLE(techmap_order_items, "Part of an order item quantity allocated to a technological map") {
  * PFK(techmap_id) : BIGINT
  * PFK(order_item_id) : BIGINT
  --
  * quantity : NUMERIC(14,3) <<CK > 0>>
}

TABLE(recipe_stages, "Production stages of a product and the work station type each one needs") {
  * PK(id) : BIGSERIAL
  --
  * name : VARCHAR(255)
  description : TEXT
  * FK(nomenclature_id) : BIGINT
  * FK(work_station_type_id) : INTEGER
}

TABLE(techmap_stages, "Recipe stage instantiated in a map and scheduled on a work station") {
  * PK(id) : BIGSERIAL
  --
  * FK(techmap_id) : BIGINT
  * FK(recipe_stage_id) : BIGINT
  * FK(work_station_booking_id) : BIGINT <<UQ>>
  description : TEXT
}

TABLE(techmap_stage_param_values, "Setpoints of work station parameters for a map stage") {
  * PK(id) : BIGSERIAL
  --
  * FK(techmap_stage_id) : BIGINT
  * FK(work_station_param_id) : BIGINT
  num_value : NUMERIC(18,6)
  string_value : TEXT
  timestamp_value : TIMESTAMPTZ
  <<UQ (techmap_stage_id, work_station_param_id)>>
}

' ---------------- Work stations ----------------
TABLE(work_station_types, "Dictionary of equipment types") {
  * PK(id) : SERIAL
  --
  * name : VARCHAR(128) <<UQ>>
  description : TEXT
}

TABLE(work_stations, "Equipment units of the plant") {
  * PK(id) : BIGSERIAL
  --
  * name : VARCHAR(128) <<UQ>>
  description : TEXT
  * FK(type_id) : INTEGER
  * is_available : BOOLEAN <<DF true>>
}

TABLE(work_station_bookings, "Time slots reserved on a work station") {
  * PK(id) : BIGSERIAL
  --
  * FK(work_station_id) : BIGINT
  description : TEXT
  * FK(creator_id) : BIGINT
  * start_timestamp : TIMESTAMPTZ
  * finish_timestamp : TIMESTAMPTZ
  <<CK finish_timestamp > start_timestamp>>
}

TABLE(work_station_param_types, "Dictionary of parameter data types") {
  * PK(id) : SERIAL
  --
  * name : VARCHAR(32) <<UQ>>
  description : TEXT
}

TABLE(work_station_params, "Parameters supported by a work station type") {
  * PK(id) : BIGSERIAL
  --
  * name : VARCHAR(128)
  description : TEXT
  * FK(work_station_type_id) : INTEGER
  * FK(param_type_id) : INTEGER
  <<UQ (work_station_type_id, name)>>
}

' ---------------- Telemetry & alerts ----------------
TABLE(telemetry_items, "Parameter values measured on work stations") {
  * PK(id) : BIGSERIAL
  --
  * measurement_timestamp : TIMESTAMPTZ
  * FK(techmap_stage_param_id) : BIGINT
  * num_value : DOUBLE PRECISION
}

TABLE(alerts, "Alerts raised by telemetry deviating from the setpoint") {
  * PK(id) : BIGSERIAL
  --
  * FK(telemetry_item_id) : BIGINT
}

TABLE(alert_unread_by, "Users who have not read an alert yet") {
  * PFK(alert_id) : BIGINT
  * PFK(app_user_id) : BIGINT
}

' ================= Foreign keys =================
roles         ||--o{ app_users    : role_id
app_users     ||--o{ user_tokens  : user_id

customers     ||--o{ customer_contacts : customer_id
contact_types ||--o{ customer_contacts : contact_type_id
customers     ||--o{ orders            : customer_id
app_users     ||--o{ orders            : creator_id

orders        ||--|{ order_items  : order_id
nomenclatures ||--o{ order_items  : nomenclature_id

app_users     ||--o{ techmaps            : creator_id
techmaps      ||--|{ techmap_order_items : techmap_id
order_items   ||--o{ techmap_order_items : order_item_id

nomenclatures      ||--o{ recipe_stages  : nomenclature_id
work_station_types ||--o{ recipe_stages  : work_station_type_id
techmaps           ||--|{ techmap_stages : techmap_id
recipe_stages      ||--o{ techmap_stages : recipe_stage_id

work_station_types       ||--o{ work_stations         : type_id
work_station_types       ||--o{ work_station_params   : work_station_type_id
work_station_param_types ||--o{ work_station_params   : param_type_id
work_stations            ||--o{ work_station_bookings : work_station_id
app_users                ||--o{ work_station_bookings : creator_id
work_station_bookings    ||--|| techmap_stages        : work_station_booking_id

techmap_stages      ||--o{ techmap_stage_param_values : techmap_stage_id
work_station_params ||--o{ techmap_stage_param_values : work_station_param_id

techmap_stage_param_values ||--o{ telemetry_items : techmap_stage_param_id
telemetry_items            ||--o{ alerts          : telemetry_item_id
alerts                     ||--o{ alert_unread_by : alert_id
app_users                  ||--o{ alert_unread_by : app_user_id

' ================= Implementation notes =================
note right of techmap_order_items
  quantity <= order_items.quantity
             - SUM(quantity) already allocated
  for the same order_item_id.
  Cross-row rule: enforce with a trigger
  (or in the service layer).
end note

note bottom of work_station_param_types
  Seed values: Bool, Number,
  String, Timestamp, …
end note

note bottom of contact_types
  Seed values: tel, email, website,
  telegram, post address, …
  regex validates customer_contacts.value
end note

note bottom of work_station_bookings
  Suggested: EXCLUDE USING gist
  (work_station_id WITH =,
   tstzrange(start_timestamp, finish_timestamp) WITH &&)
  to prevent overlapping bookings.
end note

note bottom of telemetry_items
  Index: (techmap_stage_param_id,
          measurement_timestamp)
end note

legend right
  <b><color:#B8860B><&key></color></b> primary key
  <color:#4B55B5><&link-intact></color> foreign key
  <b><color:#B8860B><&key></color><color:#4B55B5><&link-intact></color></b> PK + FK
  * NOT NULL
endlegend

@enduml
